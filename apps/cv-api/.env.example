# Connexion MariaDB/MySQL. Mot de passe : encoder les caracteres speciaux (%40 pour @, etc.)
DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:3306/NOM_BASE"

# Secret de signature des jetons JWT : 48 octets aleatoires
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Port d'ecoute (fourni par le Manager en production ; 3000 par defaut)
PORT=3000

# Origines CORS autorisees, separees par des virgules.
# A laisser en commentaire en local (origines de developpement par defaut).
# Production, meme origine : decommenter et renseigner (valeur non vide).
# CORS_ORIGINS=https://cv.diadelux.fr